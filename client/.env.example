# Public build-time settings. Everything prefixed VITE_ is embedded in the
# browser bundle — never put secrets (DB URI, JWT secret, passwords) here.

# Base URL of the Express API. The trailing /api is optional (added if missing).
# Local:      http://localhost:5000/api
# Production: https://YOUR-RENDER-SERVICE.onrender.com/api  (set in Vercel → Environment Variables)
VITE_API_URL=http://localhost:5000/api

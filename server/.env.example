# Copy to server/.env for local development. Placeholders only — never commit real values.
# On Render, set these in the service's Environment tab instead.

# development | production
NODE_ENV=development
# Render injects PORT automatically; 5000 is the local default
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/darshan-portfolio

# Allowed browser origins, comma separated (no trailing slash).
# Either variable works; both are merged. http://localhost:5173 is always
# allowed when NODE_ENV is not "production".
# Production: https://darshanbr.vercel.app
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=

# Admin authentication (single admin)
ADMIN_EMAIL=admin@example.com
# bcrypt hash — generate with: npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Long random string — e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Optional: email notification for new contact messages (Resend)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
